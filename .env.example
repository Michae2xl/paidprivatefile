# Optional production CipherPay integration.
CIPHERPAY_API_URL=
CIPHERPAY_API_KEY=
CIPHERPAY_WEBHOOK_SECRET=

# Real on-chain ZEC payment mode. When set to 1, payment intents assign a unique
# per-order deposit Unified Address from a pool and settlement comes from a
# signed local watcher. Leave unset/0 to keep the dev/CipherPay rail unchanged.
# The wallet and keys stay on the local side; only signed reports cross to prod.
PAID_PRIVATE_FILE_ZCASH_ONCHAIN=0
# HMAC secret for POST /api/transfers/payments/zcash/addresses (pool filler).
PAID_PRIVATE_FILE_ZCASH_POOL_SECRET=replace-with-a-long-random-pool-secret
# HMAC secret for POST /api/webhooks/zcash (local payment watcher report).
PAID_PRIVATE_FILE_ZCASH_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
# Minimum confirmations before an on-chain deposit settles an order (default 10).
PAID_PRIVATE_FILE_ZCASH_MIN_CONFIRMATIONS=10

# Local runtime storage. Defaults to the OS temp dir if unset.
PAID_PRIVATE_FILE_RUNTIME_DIR=./runtime

# Token secret for signed file download URLs.
PAID_PRIVATE_FILE_TRANSFER_TOKEN_SECRET=replace-with-a-long-random-secret
PAID_PRIVATE_FILE_AUTH_SECRET=replace-with-a-long-random-auth-secret
PAID_PRIVATE_FILE_REQUIRE_NYM_DELIVERY=0
PAID_PRIVATE_FILE_ALLOW_LOCAL_NYM_OUTBOX=0
PAID_PRIVATE_FILE_ALLOW_HTTP_CLAIM_RESPONSE=0

# Trust x-forwarded-for / x-real-ip only behind a controlled proxy.
PAID_PRIVATE_FILE_TRUST_PROXY_HEADERS=0

# Browser-direct Nym key delivery (frente B). When both flags are set to 1, the
# SELLER browser sends the wrapped key envelope over the Nym mixnet straight to
# the BUYER browser; the server stops relaying the key over Nym (no server
# nym-client needed). The claim returns deliveryMode "browser-nym" with the
# signed ciphertext download URL but never the key envelope — that transits the
# mixnet browser-to-browser. The server-side flag gates the claim contract; the
# NEXT_PUBLIC flag lets the seller/buyer UI know browser-Nym mode is active.
# Leave both at 0 to keep the existing server-relayed / dev-fallback behavior.
PAID_PRIVATE_FILE_BROWSER_NYM_DELIVERY=0
NEXT_PUBLIC_PPF_BROWSER_NYM=0

# Multi-buyer "product" model (Phase 3a). When "1", the seller's create form
# publishes a PRODUCT (one catalog entry many buyers can purchase) instead of a
# single-use file, and the dashboard lists those products. Default OFF: with the
# flag off the create + dashboard behave byte-for-byte like the single-use flow.
NEXT_PUBLIC_PPF_PRODUCTS=0

# Core private transport.
# For real nym-claim-v1, run nym-client and set this to ws://127.0.0.1:1977.
NYM_CLIENT_ENDPOINT=
NYM_CLIENT_SEND_PATH=/v1/messages
NYM_CLIENT_API_KEY=
NYM_DELIVERY_REQUIRED=1
NYM_CLIENT_TIMEOUT_MS=10000
NYM_SERVICE_PROVIDER_ADDRESS=
NYM_TRANSPORT_MODE=nym-claim-v1
NEXT_PUBLIC_NYM_API_URL=https://validator.nymtech.net/api
NEXT_PUBLIC_NYM_FORCE_TLS=1

# Buyer-side local receiver helper. The integrated site implementation uses
# this URL to auto-detect the private receiver and hide Nym from the normal UX.
NEXT_PUBLIC_NYM_LOCAL_BRIDGE_URL=http://127.0.0.1:1978
NYM_BRIDGE_HOST=127.0.0.1
NYM_BRIDGE_PORT=1978
NYM_BRIDGE_WS_URL=ws://127.0.0.1:1977
NYM_BRIDGE_API_KEY=
NYM_BRIDGE_ADDRESS_AUTH=0
NYM_BRIDGE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
